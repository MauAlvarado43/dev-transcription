{
  "name": "dev-transcription",
  "displayName": "Dev Transcription",
  "description": "%extension.description%",
  "version": "0.4.0",
  "publisher": "raide",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MauAlvarado43/dev-transcription.git"
  },
  "homepage": "https://github.com/MauAlvarado43/dev-transcription#readme",
  "bugs": {
    "url": "https://github.com/MauAlvarado43/dev-transcription/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "video",
    "transcription",
    "whisper",
    "local",
    "subtitles"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "devTranscription.import",
        "title": "%command.import.title%",
        "category": "Dev Transcription",
        "icon": "$(add)"
      },
      {
        "command": "devTranscription.collection",
        "title": "%command.collection.title%",
        "category": "Dev Transcription",
        "icon": "$(new-folder)"
      },
      {
        "command": "devTranscription.refresh",
        "title": "%command.refresh.title%",
        "category": "Dev Transcription",
        "icon": "$(refresh)"
      },
      {
        "command": "devTranscription.setup",
        "title": "%command.setup.title%",
        "category": "Dev Transcription"
      },
      {
        "command": "devTranscription.downloadModel",
        "title": "%command.downloadModel.title%",
        "category": "Dev Transcription"
      },
      {
        "command": "devTranscription.storage",
        "title": "%command.storage.title%",
        "category": "Dev Transcription"
      },
      {
        "command": "devTranscription.settings",
        "title": "%command.settings.title%",
        "category": "Dev Transcription",
        "icon": "$(settings-gear)"
      },
      {
        "command": "devTranscription.logs",
        "title": "%command.logs.title%",
        "category": "Dev Transcription"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devTranscription",
          "title": "Dev Transcription",
          "icon": "media/dev-transcription.svg"
        }
      ]
    },
    "views": {
      "devTranscription": [
        {
          "id": "devTranscription.library",
          "name": "%view.library.name%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "devTranscription.import",
          "when": "view == devTranscription.library",
          "group": "navigation@1"
        },
        {
          "command": "devTranscription.refresh",
          "when": "view == devTranscription.library",
          "group": "navigation@2"
        },
        {
          "command": "devTranscription.settings",
          "when": "view == devTranscription.library",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Dev Transcription",
      "properties": {
        "devTranscription.model": {
          "type": "string",
          "default": "large-v3",
          "enum": [
            "large-v3",
            "turbo",
            "medium",
            "small",
            "base",
            "tiny"
          ],
          "scope": "application",
          "description": "%config.model.description%"
        },
        "devTranscription.device": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "cpu",
            "cuda"
          ],
          "scope": "machine",
          "description": "%config.device.description%"
        },
        "devTranscription.language": {
          "type": "string",
          "default": "auto",
          "scope": "application",
          "description": "%config.language.description%",
          "enum": [
            "auto",
            "es",
            "en"
          ]
        },
        "devTranscription.initialPrompt": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%config.initialPrompt.description%"
        },
        "devTranscription.offline": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%config.offline.description%"
        },
        "devTranscription.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.pythonPath.description%"
        },
        "devTranscription.diarization": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.diarization.description%"
        },
        "devTranscription.numSpeakers": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 30,
          "scope": "application",
          "description": "%config.numSpeakers.description%"
        },
        "devTranscription.speakerThreshold": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.1,
          "maximum": 0.95,
          "scope": "application",
          "description": "%config.speakerThreshold.description%"
        },
        "devTranscription.groupDialogues": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.groupDialogues.description%"
        },
        "devTranscription.dialogueGapSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 30,
          "scope": "application",
          "description": "%config.dialogueGapSeconds.description%"
        },
        "devTranscription.dialogueMaxSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 300,
          "scope": "application",
          "description": "%config.dialogueMaxSeconds.description%"
        },
        "devTranscription.interfaceLanguage": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "es"
          ],
          "scope": "application",
          "description": "%config.interfaceLanguage.description%",
          "enumDescriptions": [
            "%config.interfaceLanguage.english%",
            "%config.interfaceLanguage.spanish%"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts && python3 -m unittest discover -s test -p '*_test.py'",
    "check": "npm run typecheck && npm test && npm run build && npm run release:notes",
    "release:notes": "node scripts/extract-release-notes.mjs dist/release-notes.md",
    "vscode:prepublish": "npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  }
}
